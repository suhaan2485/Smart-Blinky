##Ardiono Codes
( i wil be using these C++ codes in Ardiono App )

#mapping pinouts:

int BUT1 = D0;
int BUT2 = D1;
int BUT3 = D2;

int LED1 = D3;
int LED2 = D4;
int LED3 = D5; 

#declearing input/output and basic void setup + main code:

void setup()
{
  pinMode(BUT1, INPUT_PULLUP);
  pinMode(BUT2, INPUT_PULLUP);
  pinMode(BUT3, INPUT_PULLUP);

  pinMode(LED1, OUTPUT);
  pinMode(LED2, OUTPUT);
  pinMode(LED3, OUTPUT);

  //signature startup led blink 123-123-123
  delay(5000);

  for(int i = 0; i < 3; i++)
  {
    digitalWrite(LED1, HIGH);
    delay(200);
    digitalWrite(LED1, LOW);

    digitalWrite(LED2, HIGH);
    delay(200);
    digitalWrite(LED2, LOW);

    digitalWrite(LED3, HIGH);
    delay(200);
    digitalWrite(LED3, LOW);

    delay(150);
  }

  randomSeed(analogRead(A0));
}

void loop()
{

  //BUT1 = Random LED
  if(digitalRead(BUT1) == LOW)
  {
    int randomLED = random(1,4);

    digitalWrite(LED1, LOW);
    digitalWrite(LED2, LOW);
    digitalWrite(LED3, LOW);

    if(randomLED == 1)
    {
      digitalWrite(LED1, HIGH);
    }

    if(randomLED == 2)
    {
      digitalWrite(LED2, HIGH);
    }

    if(randomLED == 3)
    {
      digitalWrite(LED3, HIGH);
    }

    delay(300);
  }

  //BUT2 = sequence 2-(1+3)
  if(digitalRead(BUT2) == LOW)
  {


    digitalWrite(LED2, HIGH);
    delay(300);
    digitalWrite(LED2, LOW);


    digitalWrite(LED1, HIGH);
    digitalWrite(LED3, HIGH);

    delay(400);

    digitalWrite(LED1, LOW);
    digitalWrite(LED3, LOW);
  }

  //BUT3 = Cool Light effect
  if(digitalRead(BUT3) == LOW)
  {

    digitalWrite(LED1, HIGH);
    delay(120);
    digitalWrite(LED1, LOW);

    digitalWrite(LED2, HIGH);
    delay(120);
    digitalWrite(LED2, LOW);

    digitalWrite(LED3, HIGH);
    delay(120);
    digitalWrite(LED3, LOW);

    digitalWrite(LED2, HIGH);
    delay(120);
    digitalWrite(LED2, LOW);

    digitalWrite(LED1, HIGH);
    delay(120);
    digitalWrite(LED1, LOW);
  }

}
